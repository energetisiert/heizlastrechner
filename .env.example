# ============================================================================
# Heizlastrechner — Environment Variables
# Lokal: Werte in .env.local eintragen (nie committen).
# Vercel: Project Settings -> Environment Variables.
# ============================================================================

# --- Supabase (setzt die Vercel-Supabase-Integration automatisch) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ältere Bezeichnung, funktioniert ebenfalls:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUR serverseitig, nie mit NEXT_PUBLIC_ prefixen. Wird für die Lead-Annahme
# und das Rate-Limiting (bump_rate_limit) verwendet.
SUPABASE_SECRET_KEY=
# Ältere Bezeichnung: SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---------------------------------------------------------------
# Getrennte Secrets für getrennte Zwecke — je ein eigenes, unabhängiges
# Geheimnis, damit ein kompromittierter Wert das andere nicht mit reißt.
# Beide erzeugen z. B. mit: openssl rand -hex 32

# Salt für IP-Hashing (SHA-256(IP + Salt), DSGVO: keine Klartext-IPs).
# Fehlt der Wert, läuft das Rate-Limiting im Fail-open-Modus
# (Warnung im Log, Seite funktioniert) — für Produktion zwingend setzen.
IP_SALT=

# HMAC-Schlüssel für die Signatur der kurzlebigen Request-Tokens.
# Fehlt der Wert, läuft die Token-Prüfung im Fail-open-Modus
# (Warnung im Log, Seite funktioniert) — für Produktion zwingend setzen.
REQUEST_TOKEN_SECRET=

# Vercel BotID benötigt KEINE Env-Variablen — die Verifikation läuft über
# die Vercel-Infrastruktur (checkBotId schlägt lokal nie an).

# --- Optional ----------------------------------------------------------------
# n8n-Webhook für Vor-Ort-Anfragen, sobald der Workflow steht:
# N8N_WEBHOOK_HEIZLAST_ANFRAGE=
